# Copy to .env. Model paths default to ignored models/ directories in this repo;
# paths are relative to the repository root, even when invoked elsewhere.
VLLM_IMAGE=tiangong-vllm:qwen38-autotune-v1
MODEL_DIR=./models/Qwen3.8-Flash-Next-NVFP4
SERVED_MODEL_NAME=nv-community/Qwen3.8-Flash-Next-NVFP4
VLLM_HOST=0.0.0.0
VLLM_PORT=7730
# Optional: empty/unset disables authentication. Set a key to require Bearer auth.
VLLM_API_KEY=
GPU_0=0
GPU_1=1
GPU_2=2
GPU_3=3
TENSOR_PARALLEL_SIZE=4
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
# Validated MTP default; set empty to disable, or use 1 for one draft token.
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
# Keep 0: the pinned FlashInfer build lacks PcieIpcAllReduceWorkspace.
VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC=0

# Separate Nemotron embedding service. Choose its startup free-memory check
# per host after accounting for MinerU or other processes sharing these GPUs.
# pull embed verifies the pinned upstream digest and assigns this portable local tag.
EMBED_IMAGE=tiangong-embed:vllm0.25.0
EMBED_MODEL_DIR=./models/Nemotron-3-Embed-8B-BF16
EMBED_SERVED_MODEL_NAME=nv-community/Nemotron-3-Embed-8B-BF16
EMBED_HOST=127.0.0.1
EMBED_PORT=7731
EMBED_API_KEY=
EMBED_GPU_0=0
EMBED_GPU_1=1
EMBED_GPU_2=2
EMBED_GPU_3=3
# Required for embed deployment. For this encoder-only model, this fraction
# checks free VRAM at startup; it is not a reservation or process memory cap.
EMBED_GPU_MEMORY_UTILIZATION=
# 32K is a per-request limit. The batched-token cap is shared per replica
# per scheduling step; a full-length request can occupy that step alone.
EMBED_MAX_MODEL_LEN=32768
EMBED_MAX_NUM_BATCHED_TOKENS=32768
EMBED_MAX_NUM_SEQS=4

# Optional three-GPU Nemotron Embed profile for a 3 x RTX PRO 6000 host.
# It has its own Compose project, cache, GPU assignment, and credentials.
# Both profiles default to port 7731 because they are mutually exclusive.
# The model directory may point to the same verified snapshot as the four-GPU profile.
# Do not start embed and embed3 together on the same host.
EMBED3_IMAGE=tiangong-embed:vllm0.25.0
EMBED3_MODEL_DIR=./models/Nemotron-3-Embed-8B-BF16
EMBED3_SERVED_MODEL_NAME=nv-community/Nemotron-3-Embed-8B-BF16
EMBED3_HOST=127.0.0.1
EMBED3_PORT=7731
EMBED3_API_KEY=
EMBED3_GPU_0=0
EMBED3_GPU_1=1
EMBED3_GPU_2=2
# Required for embed3 deployment; startup free-VRAM check, not a process limit.
EMBED3_GPU_MEMORY_UTILIZATION=
EMBED3_MAX_MODEL_LEN=32768
EMBED3_MAX_NUM_BATCHED_TOKENS=32768
EMBED3_MAX_NUM_SEQS=4
