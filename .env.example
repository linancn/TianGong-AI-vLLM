# Copy to .env. Paths are relative to the repository root.
VLLM_IMAGE=tiangong-vllm:qwen38-autotune-v1
MODEL_DIR=./models/Qwen3.8-Flash-Next-NVFP4
SERVED_MODEL_NAME=nv-community/Qwen3.8-Flash-Next-NVFP4
VLLM_HOST=0.0.0.0
VLLM_PORT=7730
# Optional: empty/unset disables authentication. Set a key to require Bearer auth.
VLLM_API_KEY=
GPU_0=0
GPU_1=1
GPU_2=2
GPU_3=3
TENSOR_PARALLEL_SIZE=4
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
# Validated MTP default; set empty to disable, or use 1 for one draft token.
SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
# Keep 0: the pinned FlashInfer build lacks PcieIpcAllReduceWorkspace.
VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC=0
