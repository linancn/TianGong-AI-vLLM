{
  "backend_name": "tiangong-lca-nemotron-custom",
  "description": "Published LCA-Nemotron-Embed-1B reference runtime; one GPU per deployment",
  "default_version": "st5.3.0-r2-custom",
  "version_configs": {
    "st5.3.0-r2-custom": {
      "image_name": "tiangong-lca-nemotron:st5.3.0-r2",
      "custom_framework": "cuda",
      "entrypoint": "python /opt/lca/server.py",
      "run_command": "--model {{model_path}} --host {{worker_ip}} --port {{port}} --served-model-name {{model_name}} --read-only-model-mount"
    },
    "st5.3.0-r1-custom": {
      "image_name": "tiangong-lca-nemotron:st5.3.0-r1",
      "custom_framework": "cuda",
      "entrypoint": "python /opt/lca/server.py",
      "run_command": "--model {{model_path}} --host {{worker_ip}} --port {{port}} --read-only-model-mount"
    }
  },
  "health_check_path": "/readyz",
  "default_backend_param": [],
  "default_env": {
    "GPUSTACK_MODEL_RUNTIME_SHM_SIZE_GIB": "2",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "OMP_NUM_THREADS": "4"
  }
}
